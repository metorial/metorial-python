# Metorial API Key (required)
METORIAL_API_KEY=your_metorial_api_key_here

# Anthropic API Key (required for examples using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Deployment IDs (get these from your Metorial dashboard)
EXA_DEPLOYMENT_ID=your_exa_deployment_id
HACKERNEWS_DEPLOYMENT_ID=your_hackernews_deployment_id
GOOGLE_CALENDAR_DEPLOYMENT_ID=your_google_calendar_deployment_id
